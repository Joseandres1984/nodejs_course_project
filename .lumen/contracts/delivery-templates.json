{
  "version": "2026-09-21-v1",
  "brand": {
    "name": "LUMEN",
    "descriptor": "B2B Intelligence",
    "tone": "ejecutivo, claro, verificable y accionable",
    "visual_principles": [
      "Portada limpia con nombre del servicio, cliente, fecha e ID de informe",
      "Resumen ejecutivo visible antes del detalle",
      "Tablas comparables y jerarquía visual consistente",
      "Fuentes públicas trazables con URL y fecha de consulta",
      "Riesgos separados de hechos y de inferencias",
      "Conclusión y próximos pasos siempre al final"
    ],
    "truth_rules": [
      "No presentar hipótesis como hechos",
      "No inventar datos faltantes",
      "Distinguir evidencia pública, inferencia y recomendación",
      "No prometer resultados comerciales futuros",
      "Indicar limitaciones materiales del análisis"
    ]
  },
  "tiers": {
    "micro": {
      "format": "brief ejecutivo",
      "target_length": "1-3 páginas equivalentes",
      "purpose": "resolver una pregunta concreta con velocidad",
      "required_sections": ["portada_compacta", "pedido_del_cliente", "respuesta_ejecutiva", "hallazgos", "evidencia", "riesgos", "proximo_paso", "fuentes_y_limites"]
    },
    "full": {
      "format": "informe ejecutivo profesional",
